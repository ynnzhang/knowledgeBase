{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "local": "node scripts/start-local.mjs",
    "check:project": "node scripts/start-local.mjs --check",
    "predev": "npm run check:project",
    "dev": "concurrently --kill-others-on-fail --names notes,site --prefix-colors cyan,green \"npm:notes:watch\" \"npm:dev:site\"",
    "dev:site": "vinext dev",
    "notes:sync": "node scripts/sync-notes.mjs",
    "notes:watch": "node scripts/sync-notes.mjs --watch",
    "test:local": "node --test scripts/local-notes.test.mjs scripts/local-files.test.mjs scripts/local-workspace.test.mjs scripts/local-platform.test.mjs scripts/check-project.test.mjs",
    "test:feishu": "node --test scripts/feishu-sync.test.mjs",
    "test:outline": "node --experimental-strip-types --test scripts/note-outline.test.mjs",
    "prebuild": "npm run notes:sync",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "@lexical/react": "^0.48.0",
    "@lexical/rich-text": "^0.48.0",
    "@lexical/selection": "^0.48.0",
    "@mdxeditor/editor": "^4.2.3",
    "@mdxeditor/gurx": "^1.2.4",
    "lexical": "^0.48.0",
    "lucide-react": "^1.34.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-to-markdown-cjk-friendly": "^1.0.0",
    "micromark-extension-cjk-friendly": "^2.0.1",
    "next": "16.2.6",
    "parse5": "^7.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "concurrently": "^10.0.5",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
