{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "local": "node scripts/start-local.mjs",
    "check:project": "node scripts/start-local.mjs --check",
    "predev": "node scripts/start-local.mjs --prepare",
    "dev": "concurrently --kill-others-on-fail --names notes,site --prefix-colors cyan,green \"npm:notes:watch\" \"npm:dev:site\"",
    "dev:site": "next dev --webpack --hostname 127.0.0.1 --port 3000",
    "predev:site": "node scripts/start-local.mjs --prepare",
    "notes:sync": "node scripts/sync-notes.mjs",
    "notes:watch": "node scripts/sync-notes.mjs --watch",
    "test:local": "node --test scripts/local-notes.test.mjs scripts/local-files.test.mjs scripts/local-workspace.test.mjs scripts/local-platform.test.mjs scripts/check-project.test.mjs scripts/check-dependencies.test.mjs scripts/note-index.test.mjs",
    "test:feishu": "node --test scripts/feishu-sync.test.mjs",
    "test:outline": "node --experimental-strip-types --test scripts/note-outline.test.mjs",
    "prebuild": "node scripts/start-local.mjs --prepare",
    "build": "next build --webpack",
    "start": "node scripts/start-production.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "dev:preview": "vinext dev",
    "build:preview": "npm run notes:sync && vinext build",
    "test:editor": "node --test scripts/code-fence.test.mjs scripts/heading-shortcuts.test.mjs",
    "test:production": "node --test scripts/production-supervisor.test.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:local && npm run test:feishu && npm run test:outline && npm run test:editor && npm run test:production",
    "test:smoke": "node --test scripts/production-smoke.test.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.9",
    "@lexical/react": "^0.48.0",
    "@lexical/rich-text": "^0.48.0",
    "@lexical/selection": "^0.48.0",
    "@lezer/highlight": "^1.2.3",
    "@mdxeditor/editor": "^4.2.3",
    "@mdxeditor/gurx": "^1.2.4",
    "codemirror": "^6.0.2",
    "lexical": "^0.48.0",
    "lucide-react": "^1.34.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-to-markdown-cjk-friendly": "^1.0.0",
    "micromark-extension-cjk-friendly": "^2.0.1",
    "next": "16.2.6",
    "parse5": "^7.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "concurrently": "^10.0.5",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
